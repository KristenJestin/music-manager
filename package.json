{
  "name": "music-manager",
  "version": "0.0.0",
  "private": true,
  "description": "Self-hosted music importer and tagger: YouTube to MusicBrainz, the full standard tag superset, filed into a library Navidrome reads.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KristenJestin/music-manager.git"
  },
  "license": "UNLICENSED",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "bun": ">=1.3.0"
  },
  "scripts": {
    "dev": "bun run scripts/dev.ts",
    "dev:portless": "bun run scripts/portless.ts",
    "dev-portless": "bun run scripts/portless.ts",
    "stack:up": "bun run scripts/stack.ts up",
    "stack:down": "bun run scripts/stack.ts down",
    "stack:info": "bun run scripts/stack.ts info",
    "stack-up": "bun run scripts/stack.ts up",
    "stack-down": "bun run scripts/stack.ts down",
    "stack-info": "bun run scripts/stack.ts info",
    "check": "bun run scripts/check.ts",
    "test": "bun run scripts/test.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "bun run scripts/typecheck.ts",
    "db:generate": "bun run scripts/db.ts generate",
    "db:migrate": "bun run scripts/db.ts migrate",
    "db:reset": "bun run scripts/db.ts reset",
    "db-generate": "bun run scripts/db.ts generate",
    "db-migrate": "bun run scripts/db.ts migrate",
    "db-reset": "bun run scripts/db.ts reset",
    "toolbox:openapi": "bun run scripts/toolbox-openapi.ts",
    "toolbox-openapi": "bun run scripts/toolbox-openapi.ts",
    "e2e": "bun run scripts/e2e-web.ts",
    "compose:up": "bun run scripts/stack.ts up",
    "compose:down": "bun run scripts/stack.ts down",
    "worker": "bun run scripts/worker.ts",
    "dev:worker": "bun run scripts/worker.ts",
    "dev-worker": "bun run scripts/worker.ts",
    "mm": "bun run scripts/mm.ts",
    "e2e-fixture": "bun run scripts/e2e-fixture.ts",
    "cache:seed-fixtures": "bun run apps/web/src/server/integrations/seed-fixtures.ts",
    "cache-seed-fixtures": "bun run apps/web/src/server/integrations/seed-fixtures.ts",
    "e2e-web": "bun run scripts/e2e-web.ts",
    "e2e:web": "bun run scripts/e2e-web.ts",
    "e2e-verify": "bun run scripts/e2e-verify.ts",
    "e2e:verify": "bun run scripts/e2e-verify.ts",
    "navidrome:record": "bun run apps/web/src/server/integrations/navidrome/record-cassettes.ts",
    "e2e-migrate": "bun run scripts/e2e-migrate.ts",
    "e2e:migrate": "bun run scripts/e2e-migrate.ts",
    "e2e-all": "bun run scripts/e2e-all.ts",
    "e2e:all": "bun run scripts/e2e-all.ts",
    "fixtures:v1": "bun run fixtures/v1/generate.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/bun": "^1.4.1",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.69.0",
    "vitest": "^4.1.11"
  }
}
