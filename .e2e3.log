    id: 'D:/Projects/music-manager/v2/apps/web/src/routes/_app.library.index.tsx',
    pluginCode: '/**\n' +
      ' * `/library` — the album grid.\n' +
      ' *\n' +
      ' * The one screen that answers "what do I actually have?", so it is a grid of covers with the\n' +
      ' * two facts that matter written on them: how many tracks are present, and how complete the\n' +
      ' * metadata is. Everything else — the filters, the sort, the profile — is in the URL, so a\n' +
      " * filtered view is a link and the dashboard's tiles can point straight at one.\n" +
      ' *\n' +
      ' * The completeness badge is the *global* score by default. Switching the profile re-labels\n' +
      ' * every badge with "as Navidrome reads it" and changes nothing about the files, which is said\n' +
      ' * in the toolbar rather than left to be inferred.\n' +
      ' */\n' +
      'import { useState } from "react";\n' +
      'import { Link, createFileRoute, useNavigate } from "@tanstack/react-router";\n' +
      'import { z } from "zod";\n' +
      'import { PROFILE_IDS } from "@mm/domain";\n' +
      'import { LayoutGrid, Plus, ShieldCheck } from "lucide-react";\n' +
      'import { Button } from "#/components/ui/button.tsx";\n' +
      'import { Select, SelectContent, SelectItem, SelectTrigger } from "#/components/ui/select.tsx";\n' +
      '\n' +
      'import { Callout } from "#/components/callout.tsx";\n' +
      'import { PageHeader } from "#/components/page-header.tsx";\n' +
      'import { SearchInput } from "#/components/search-input.tsx";\n' +
      'import { StatTile } from "#/components/stat-tile.tsx";\n' +
      'import { scoreTone } from "#/components/status-badge.tsx";\n' +
      'import { AlbumCard } from "#/components/library/album-card.tsx";\n' +
      'import { ToneBadge, scoreTone } from "#/components/status-badge.tsx";\n' +
      'import { FilterBar } from "#/components/library/filter-bar.tsx";\n' +
      'import { FilterChips } from "#/components/library/filter-chips.tsx";\n' +
      'import { pct } from "#/lib/format.ts";\n' +
      'import { ALBUM_FILTER_FIELDS } from "#/lib/filters/index.ts";\n' +
      'import { ALBUM_FILTERS, ALBUM_SORTS } from "#/lib/library-filters.ts";\n' +
      'import { fetchAlbums } from "#/server/functions/library.ts";\n' +
      '\n' +
      'const search = z.object({\n' +
      '  q: z.string().default(""),\n' +
      '  filter: z.enum(ALBUM_FILTERS).default("all"),\n' +
      '  sort: z.enum(ALBUM_SORTS).default("recent"),\n' +
      '  profile: z.enum(["global", ...PROFILE_IDS]).default("global"),\n' +
      '  /*\n' +
      "   * The filter builder's tree, as the expression `lib/filters/schema.ts` reads. A string\n" +
      '   * here rather than a parsed object: `validateSearch` runs in the browser on every\n' +
      '   * navigation, and what has to survive is the *link* — the tree is validated against this\n' +
      "   * page's whitelist on the server, which is the only side that can refuse it usefully.\n" +
      '   */\n' +
      '  f: z.string().max(2_000).default(""),\n' +
      '});\n' +
      '\n' +
      'export const Route = createFileRoute("/_app/library/")({\n' +
      '  validateSearch: search,\n' +
      '  loaderDeps: ({ search: params }) => params,\n' +
      '  loader: async ({ deps }) =>\n' +
      '    await fetchAlbums({\n' +
      '      data: {\n' +
      '        search: deps.q,\n' +
      '        filter: deps.filter,\n' +
      '        sort: deps.sort,\n' +
      '        profile: deps.profile,\n' +
      '        f: deps.f,\n' +
      '      },\n' +
      '    }),\n' +
      '  staticData: { crumbs: [{ label: "Library" }, { label: "Albums" }] },\n' +
      '  component: Albums,\n' +
      '});\n' +
      '\n' +
      'const FILTER_LABELS: Record<(typeof ALBUM_FILTERS)[number], string> = {\n' +
      '  all: "All",\n' +
      '  incomplete: "Incomplete",\n' +
      '  untagged: "Untagged",\n' +
      '  nocover: "No cover",\n' +
      '  ytcover: "YouTube cover",\n' +
      '  schema: "Behind schema",\n' +
      '};\n' +
      '\n' +
      'const SORT_LABELS: Record<(typeof ALBUM_SORTS)[number], string> = {\n' +
      '  recent: "Recently added",\n' +
      '  artist: "Artist A–Z",\n' +
      '  year: "Year",\n' +
      '  score: "Worst metadata first",\n' +
      '};\n' +
      '\n' +
      'function Albums() {\n' +
      '  const { albums, counts, stats, total, filterError } = Route.useLoaderData();\n' +
      '  const params = Route.useSearch();\n' +
      '  const navigate = useNavigate();\n' +
      '  const [query, setQuery] = useState(params.q);\n' +
      '\n' +
      '  const profiled = params.profile !== "global";\n' +
      '  const scoreOf = (quality: (typeof albums)[number]["quality"]): number | null =>\n' +
      '    profiled ? quality.byProfile[params.profile as never] : quality.score;\n' +
      '\n' +
      '  // Takes the value rather than reading `query`: the clear button changes the state and\n' +
      '  // submits in the same tick, so the state it would read is still the old one.\n' +
      '  const submit = (q: string): void => {\n' +
      '    void navigate({ to: "/library", search: { ...params, q } });\n' +
      '  };\n' +
      '\n' +
      '  return (\n' +
      '    <>\n' +
      '      <PageHeader\n' +
      '        title="Albums"\n' +
      '        description={\n' +
      '          <>\n' +
      '            {stats.albums} albums · {stats.tracks} tracks · metadata{" "}\n' +
      '            <span className="font-mono">{pct(stats.averageScore)}</span> on average\n' +
      '            {stats.filesBehind > 0 ? (\n' +
      '              <>\n' +
      '                {" "}\n' +
      '                ·{" "}\n' +
      '                <Link\n' +
      '                  to="/library/quality"\n' +
      '                  search={{ filter: "schema", profile: "global" }}\n' +
      '                  className="text-warn"\n' +
      '                >\n' +
      '                  {stats.filesBehind} file(s) behind the tag schema\n' +
      '                </Link>\n' +
      '              </>\n' +
      '            ) : null}\n' +
      '          </>\n' +
