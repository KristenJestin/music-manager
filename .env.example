# Copy to .env and fill in. `.env` is gitignored and must never be committed.
# The owner's real values live outside this repository.

# ---------------------------------------------------------------------------
# Core
# ---------------------------------------------------------------------------

# Postgres, as served by docker-compose.dev.yml.
DATABASE_URL=postgres://mm:mm@localhost:5432/mm

# Base URL of the Python toolbox service (docker-compose.dev.yml publishes 8100).
MM_TOOLBOX_URL=http://localhost:8100

# Shared secret between apps/web and the toolbox. Leave empty in development to disable
# the check; set it in production. `/health` stays public either way so that Docker's
# healthcheck can reach it.
MM_TOOLBOX_TOKEN=

# 1 = run fully offline against recorded fixtures: no network egress, yt-dlp and every
# external source are replaced by recordings. This is the mode of the E2E tests and demos.
MM_FIXTURES=0

# Same switch, on the toolbox side (read inside the container).
MM_TOOLBOX_FIXTURES=0

# ---------------------------------------------------------------------------
# External services (not used before P04 — placeholders so the list is complete)
# ---------------------------------------------------------------------------

# MusicBrainz requires a contact string in the User-Agent: "app/version (email)".
MM_MB_CONTACT=

# AcoustID application key, for fingerprint lookups (fpcalc + AcoustID).
ACOUSTID_API_KEY=

# Last.fm API key, for listening signals and artist metadata.
LASTFM_API_KEY=

# Path to a Netscape-format cookies file for yt-dlp, mounted into the toolbox container.
YOUTUBE_COOKIES_FILE=

# fanart.tv API key, for artist and album artwork.
FANARTTV_API_KEY=
