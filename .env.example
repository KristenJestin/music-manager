# Copy to .env and fill in. `.env` is gitignored and must never be committed.
# The owner's real values live outside this repository.

# ---------------------------------------------------------------------------
# Core
# ---------------------------------------------------------------------------

# Postgres, as served by docker-compose.dev.yml.
DATABASE_URL=postgres://mm:mm@localhost:5432/mm

# Base URL of the Python toolbox service (docker-compose.dev.yml publishes 8100).
MM_TOOLBOX_URL=http://localhost:8100

# Shared secret between apps/web and the toolbox. Leave empty in development to disable
# the check; set it in production. `/health` stays public either way so that Docker's
# healthcheck can reach it.
MM_TOOLBOX_TOKEN=

# 1 = run fully offline against recorded fixtures: no network egress, yt-dlp and every
# external source are replaced by recordings. This is the mode of the E2E tests and demos.
MM_FIXTURES=0

# Same switch, on the toolbox side (read inside the container).
MM_TOOLBOX_FIXTURES=0

# 1 = refresh yt-dlp (uv pip install --upgrade) at container start-up, in addition to the
# refresh already done at image build time. Off by default so `compose up` stays
# offline-friendly (docker-compose.dev.yml, services/toolbox/src/toolbox/config.py).
MM_YTDLP_AUTOUPDATE=0

# ---------------------------------------------------------------------------
# External metadata sources (P04 — docs/03-metadonnees.md §4)
# ---------------------------------------------------------------------------
#
# Every credential has ONE canonical name, used here, inside the toolbox container and as a
# `settings` key. The order of precedence is: a non-empty row in the `settings` table wins,
# otherwise the environment variable below. `mm settings get` masks all four; nothing ever
# prints a key in full.
#
#   MM_MB_CONTACT     → mbContact      MusicBrainz User-Agent contact
#   MM_ACOUSTID_KEY   → acoustidKey    also read by services/toolbox (config.py)
#   MM_LASTFM_KEY     → lastfmKey
#   MM_FANARTTV_KEY   → fanartKey
#
# `mm sources` prints which of them are set, and every source's cache TTL.

# MusicBrainz requires a contact in the User-Agent — an e-mail address or a URL. Without it
# the client still names itself, but MusicBrainz may throttle or block it. §4 asks for it.
# It becomes: MusicManager/<version> ( <contact> )
MM_MB_CONTACT=

# AcoustID application key, for fingerprint lookups (fpcalc + AcoustID). Free, from
# https://acoustid.org/new-application. Read by the toolbox under this very name
# (services/toolbox/src/toolbox/config.py) and by apps/web's `acoustid` client.
MM_ACOUSTID_KEY=

# Last.fm API key. Optional: it is the genre/mood fallback of §4, below MusicBrainz.
# https://www.last.fm/api/account/create
MM_LASTFM_KEY=

# fanart.tv API key. Optional: the artist-image fallback when Wikimedia has none (§3).
# https://fanart.tv/get-an-api-key/
MM_FANARTTV_KEY=

# Path to a Netscape-format cookies file for yt-dlp, mounted into the toolbox container.
YOUTUBE_COOKIES_FILE=

# ---------------------------------------------------------------------------
# Library and orchestrator (P03)
# ---------------------------------------------------------------------------

# The music library as *this* process sees it. Relative paths are resolved from the
# repository root, so the default matches the bind mount of docker-compose.dev.yml.
MM_LIBRARY_ROOT=./.local/library

# The same directory as the toolbox container sees it — the other end of that bind mount.
# Two settings, not one: the orchestrator runs on the host and the toolbox in Linux, and
# every path crossing the bridge is translated between the two.
MM_TOOLBOX_LIBRARY_ROOT=/library

# Where downloads land before `place` moves them, relative to the library root. Inside the
# mount so the move is atomic, dot-prefixed so Navidrome ignores it.
MM_WORK_DIR=.mm-work

# Base URL of the web app, used by the CLI and by `bun run e2e-fixture` for the SSE check.
MM_WEB_URL=http://localhost:3000

# Pace of the fixture download inside the toolbox, in milliseconds per 16 KiB slice.
# Raise it for a demo, or to make a download last long enough to interrupt.
MM_TOOLBOX_FIXTURE_DELAY_MS=20

# ---------------------------------------------------------------------------
# Console authentication (P06)
# ---------------------------------------------------------------------------
#
# There is exactly ONE account. It is created on first boot from the two values below; if
# either is empty the app serves `/setup` once instead, and the first person to reach the
# port creates it. Neither is ever used again afterwards — changing MM_ADMIN_PASSWORD does
# not change the password, because a compose file still holding the original would otherwise
# silently undo a password change.
MM_ADMIN_EMAIL=
MM_ADMIN_PASSWORD=

# The session signing secret. `openssl rand -base64 32`. Required in production; empty in
# development derives a stable key from DATABASE_URL and says so once in the log.
MM_AUTH_SECRET=

# 1 when a reverse proxy terminates TLS in front of this process. It marks the session cookie
# `Secure` even though this process speaks plain HTTP, and lets x-forwarded-proto/-host be
# believed. Leave it off when nothing trustworthy sets those headers.
MM_BEHIND_PROXY=0

# Extra origins the Console may be reached from are a *setting*, not an environment variable:
# `mm settings set trustedOrigins '["https://music.example.com"]'`. MM_WEB_URL is always
# trusted.
