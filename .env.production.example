# Music Manager — production environment.
#
#   cp .env.production.example .env
#   $EDITOR .env
#   docker compose -f docker-compose.prod.yml up -d --build
#
# `.env` is read by `docker compose` itself, so every `${...}` in `docker-compose.prod.yml`
# resolves from this file. It is gitignored, it holds the only secrets this installation has,
# and it should be `chmod 600`.
#
# `.env.example` is the *development* file (the app on the host, containers beside it). This one
# is the deployment file: the paths are container paths, the URLs are service names, and the
# five values marked REQUIRED have no defaults on purpose — compose refuses to start rather than
# silently bringing up a Console with a guessable session key. `docs/deploy.md` walks through a
# first installation.
#
# Nothing here ever reaches a log or a commit. The three services read their secrets from the
# environment and print them nowhere; `mm settings get` masks every key it shows.

# ===========================================================================
# REQUIRED
# ===========================================================================

# --- the database ----------------------------------------------------------
# The password of the `postgres` service, and half of the DATABASE_URL compose builds for
# `web` and `worker`. Generate one: `openssl rand -hex 24`.
MM_POSTGRES_PASSWORD=

# --- sessions --------------------------------------------------------------
# The session signing secret. `openssl rand -base64 32`.
# NODE_ENV=production refuses to start with this empty — a session signed with a value
# published in the source is not a session. Changing it signs everybody out; nothing else.
MM_AUTH_SECRET=

# --- the public address ----------------------------------------------------
# The URL a browser reaches the Console at, including the scheme, with no trailing slash.
# Better Auth compares the browser's Origin against it: get this wrong and you get a login
# form that renders perfectly and answers "Invalid origin" on submit.
# Behind a reverse proxy this is the *public* URL (https://music.example.com), not
# http://localhost:3200.
MM_WEB_URL=https://music.example.com

# --- the single administrator ----------------------------------------------
# Created once, on the first boot, and never touched again — changing the password here does
# not change the password, because a compose file still holding the original would otherwise
# undo a password change at every restart. Leave both empty and the app serves `/setup` once
# instead, so that the first person to reach the port creates the account; that is the right
# choice if you would rather not have a password in a file at all.
MM_ADMIN_EMAIL=
MM_ADMIN_PASSWORD=

# ===========================================================================
# Reverse proxy
# ===========================================================================

# 1 when something in front of this stack terminates TLS. It does three things: marks the
# session cookie `Secure` although this process speaks plain HTTP, makes X-Forwarded-Proto and
# X-Forwarded-Host believable, and turns on Strict-Transport-Security and per-client rate
# limiting (which needs X-Forwarded-For to tell clients apart).
# Set it to 0 **only** if you reach the Console directly over HTTP on a trusted LAN.
MM_BEHIND_PROXY=1

# Where the published port is bound on the host. The default keeps the plain-HTTP port on the
# loopback interface, which is right when the proxy runs on the same machine. Set 0.0.0.0 when
# the proxy is on another host — and then make sure a firewall is doing the work the loopback
# binding was doing.
MM_WEB_BIND=127.0.0.1
MM_WEB_PORT=3200

# ===========================================================================
# Data
# ===========================================================================
#
# Each of the three is either the name of a volume declared in docker-compose.prod.yml — the
# default, and nothing to set up — or an absolute host path, which compose then treats as a
# bind mount. Use a host path for `library` if the music already exists somewhere, or if
# another Navidrome outside this stack has to read it.
#
# A bind-mounted directory must be writable by uid 10001 (`chown -R 10001:10001 /srv/music`);
# a named volume is created with the right ownership by the image. `docs/deploy.md` §
# « Où sont les données ».

# MM_LIBRARY_PATH=/srv/music
# MM_PGDATA_PATH=/srv/music-manager/pgdata
# MM_CACHE_PATH=/srv/music-manager/cache
# Where `mm migrate v1` writes the M3U playlists it exports. Empty means
# `<library>/_archive/v1-playlists`, the only directory the container is sure to own.
# MM_PLAYLIST_EXPORT_DIR=

# ===========================================================================
# Images
# ===========================================================================
#
# Local names by default, which is what `up -d --build` produces. Point them at a registry to
# deploy a build made elsewhere, and then `docker compose pull && up -d` is the whole upgrade:
#
#   MM_WEB_IMAGE=ghcr.io/<owner>/music-manager-web:1.4.0
#   MM_TOOLBOX_IMAGE=ghcr.io/<owner>/music-manager-toolbox:1.4.0

MM_WEB_IMAGE=music-manager-web:local
MM_TOOLBOX_IMAGE=music-manager-toolbox:local

# The target platform of the images. Production is Linux/amd64; change it only if you build
# and run on arm64, and expect the toolbox build to take longer there.
MM_PLATFORM=linux/amd64

# ===========================================================================
# Toolbox
# ===========================================================================

# Bearer token between `web`/`worker` and the toolbox. The toolbox is not published outside
# the compose network, so this defends against something already inside it; empty disables the
# check. `openssl rand -hex 32` if you want it.
MM_TOOLBOX_TOKEN=

# 1 = refresh yt-dlp at container start-up as well as at image build. On in production:
# "breaks at every YouTube change" is the first pain of docs/02-lecons-v1.md, and a restart is
# the cheapest fix. The update is best-effort — no network, no failure.
MM_YTDLP_AUTOUPDATE=1

# ===========================================================================
# Operations
# ===========================================================================

# debug | info | warn | error | silent. All three services emit JSON on stdout at this level.
MM_LOG_LEVEL=info

# Apply pending Drizzle migrations when `web` starts. Leave it on: it is what makes
# `docker compose pull && up -d` a complete upgrade. Set 0 to take the step out of the boot
# path, and then run it yourself:
#   docker compose -f docker-compose.prod.yml run --rm web migrate
MM_MIGRATE_ON_START=1

# Rate limits, in requests per window. Empty = the defaults: 10 sign-in attempts per five
# minutes, 600 API/MCP requests per minute. 0 disables a bucket.
MM_RATE_LIMIT_LOGIN=
MM_RATE_LIMIT_API=

# 1 = run the whole stack offline against recorded fixtures. This is what `scripts/smoke.sh`
# turns on for its offline pass; it has no business being 1 in a real installation.
MM_FIXTURES=0
MM_TOOLBOX_FIXTURES=0

# ===========================================================================
# External sources — all optional, all improve the tags
# ===========================================================================
#
# A non-empty row in the `settings` table wins over any of these; the Console's Settings pages
# are the normal place to put them, and `mm settings get` masks them.

# MusicBrainz asks for a contact in the User-Agent — an e-mail address or a URL. Without one
# it may throttle this installation.
MM_MB_CONTACT=

# AcoustID application key (free, https://acoustid.org/new-application). Read by the toolbox
# and by the app under this same name. Without it the fingerprint is still computed but not
# looked up.
MM_ACOUSTID_KEY=

# Last.fm — genre and mood fallback below MusicBrainz.
MM_LASTFM_KEY=

# fanart.tv — artist images when Wikimedia has none.
MM_FANARTTV_KEY=

# ===========================================================================
# Postgres identity — change before the first boot or not at all
# ===========================================================================
#
# These are baked into the data directory when postgres initialises it. Changing them after the
# first `up` does not rename anything; it only produces a `web` that cannot log in.
MM_POSTGRES_USER=mm
MM_POSTGRES_DB=mm
